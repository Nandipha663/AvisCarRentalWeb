<%@ Page Title="View Claims" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="ViewClaims.aspx.cs" Inherits="AvisSystem.AvisPages.ViewClaims" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">

    <style>
        .claims-page { padding: 30px; background: #f7f7f7; min-height: calc(100vh - 70px); }
        .table-card { background: white; padding: 30px; border-radius: 12px; border: 1px solid #e5e5e5; max-width: 1200px; box-shadow: 0 3px 10px rgba(0,0,0,0.05); margin: 0 auto; overflow-x: auto; }
        
        .claims-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .claims-table th { background: #c8102e; color: white; padding: 15px 10px; text-align: left; font-weight: 600; }
        .claims-table td { padding: 12px 10px; border-bottom: 1px solid #eee; color: #333; }
        .claims-table tr:hover { background: #fff5f6; }
        
        /* Styling the built-in GridView Edit/Delete buttons */
        .claims-table input[type="submit"], .claims-table a {
            padding: 5px 10px; border-radius: 4px; font-weight: bold; text-decoration: none; font-size: 12px; cursor: pointer;
        }
        .claims-table input[value="Update"] { background: #28a745; color: white; border: none; }
        .claims-table input[value="Cancel"] { background: #6c757d; color: white; border: none; margin-left: 5px; }
        .claims-table a[href*="Edit"] { color: #007bff; margin-right: 10px; }
        .claims-table a[href*="Delete"] { color: #dc3545; }
    </style>

    <div class="claims-page">
        <div style="max-width: 1200px; margin: 0 auto 20px auto; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h2 style="font-weight: 700; margin: 0 0 5px 0;">All Claims<asp:SqlDataSource ID="SqlDataSource1" runat="server" ConnectionString="<%$ ConnectionStrings:GroupPmb3ConnectionString %>" DeleteCommand="DELETE FROM CLAIM WHERE (ClaimID = @ClaimI)" SelectCommand="SELECT C.ClaimID, C.BookingID, B.CustomerFullName, C.ClaimType, C.ClaimDescription, C.ClaimStatus, C.ResponsibleParty, C.ClaimDate FROM CLAIM AS C INNER JOIN BOOKING AS B ON C.BookingID = B.BookingID ORDER BY C.ClaimDate" UpdateCommand="UPDATE CLAIM SET ClaimDescription = @ClaimDescription, ClaimType = @ClaimType, ClaimStatus = @ClaimStatus, ResponsibleParty = @ResponsibleParty WHERE (ClaimID = @ClaimID)">
                    <DeleteParameters>
                        <asp:Parameter Name="ClaimI" />
                    </DeleteParameters>
                    <UpdateParameters>
                        <asp:Parameter Name="ClaimDescription" />
                        <asp:Parameter Name="ClaimType" />
                        <asp:Parameter Name="ClaimStatus" />
                        <asp:Parameter Name="ResponsibleParty" />
                        <asp:Parameter Name="ClaimID" />
                    </UpdateParameters>
                    </asp:SqlDataSource>
                </h2>
                <p style="color: #777; margin: 0;">View, edit, or delete customer claims.</p>
            </div>
        </div>
          <div class="table-card">
            <!-- FIXED: Added the missing Label -->
            <asp:Label ID="lblMessage" runat="server" Font-Bold="true" style="display:block; margin-bottom:15px;"></asp:Label>

        <!-- GRIDVIEW WITH EDIT AND DELETE ENABLED -->
            <asp:GridView ID="GVClaims" runat="server" 
                DataSourceID="SqlDataSource1" 
                AutoGenerateColumns="False" 
                DataKeyNames="ClaimID"
                CssClass="claims-table" 
                GridLines="None" 
                AutoGenerateEditButton="True" 
                AutoGenerateDeleteButton="True"
                OnRowUpdating="GVClaims_RowUpdating"
                OnRowDeleting="GVClaims_RowDeleting" AllowPaging="True">
                <Columns>
                    <asp:BoundField DataField="ClaimID" HeaderText="ID" ReadOnly="True" InsertVisible="False" />
                    <asp:BoundField DataField="BookingID" HeaderText="Booking" ReadOnly="True" />
                    <asp:BoundField DataField="CustomerFullName" HeaderText="Customer" ReadOnly="True" />
                    
                  
                    <asp:BoundField DataField="ClaimType" HeaderText="Type" />
                    <asp:BoundField DataField="ClaimDescription" HeaderText="Description" />
                    <asp:BoundField DataField="ResponsibleParty" HeaderText="Party" />
                    <asp:BoundField DataField="ClaimStatus" HeaderText="Status" />
                    
                    <asp:BoundField DataField="ClaimDate" HeaderText="Date" ReadOnly="True" DataFormatString="{0:yyyy-MM-dd}" />
                </Columns>
            </asp:GridView>
        </div>
    </div>
</asp:Content>